# Local-only settings for team-ops-api in docker compose. Not used in any public environment.
APP_NAME=team-ops-api
APP_ENV=local
APP_KEY=base64:dGVhbS1vcHMtbG9jYWwtZGV2ZWxvcG1lbnQta2V5ISE=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Links in mail (login, email change) point to the web app
WEB_URL=http://localhost:5173
# php artisan serve answers several requests at once (the web app calls the API in parallel)
PHP_CLI_SERVER_WORKERS=4
APP_LOCALE=ja

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=team_ops
DB_USERNAME=team_ops
DB_PASSWORD=team_ops

QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
# Docker's private address range: the web container (Vite) forwards the client IP (local only)
TRUSTED_PROXIES=172.16.0.0/12
CACHE_STORE=database

# Local-only dummy key for the email blind index (ADR-0003)
BLIND_INDEX_KEY=base64:dGVhbS1vcHMtbG9jYWwtYmxpbmQtaW5kZXgta2V5ISE=

NOTIFY_RELAY_URL=http://notify-relay:8080
# Local-only dummy signing key, shared with notify-relay (RELAY_SIGNING_KEYS in compose.yaml)
NOTIFY_RELAY_KEY_ID=local
NOTIFY_RELAY_SECRET=bG9jYWwtZGV2LXJlbGF5LXNpZ25pbmcta2V5LTAwMDE=
# Local development sends only to .invalid addresses (spec 007 AC-007-18). DEMO_MODE=true also
# turns on the demo login and turns off login links (spec 007); leave it off for normal development.
RECIPIENTS_INVALID_ONLY=true
DEMO_MODE=false
# Where the demo reads the mails it sent (spec 007 AC-007-12). Local and demo only
MAILPIT_URL=http://mailpit:8025

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
